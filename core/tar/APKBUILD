# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=tar
pkgver=1.35
pkgrel=1
pkgdesc="Utility used to store, backup, and transport files"
url="https://www.gnu.org/software/tar/"
arch="all"
depends="qnx-io-sock"
makedepends="make qnx-io-sock-dev"
license="GPL-3.0-or-later"
subpackages="$pkgname-doc"
#source="https://ftp.gnu.org/gnu/tar/tar-$pkgver.tar.xz
source="https://mirror.csclub.uwaterloo.ca/gnu/tar/tar-$pkgver.tar.xz
        dir_open.patch
	fix-qnx-makedev.patch
	ignore-apk-tools-checksums.patch
        "

build() {
   CHOST="$CHOST" \
   ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --without-xattrs \
        --disable-rpath \
        --disable-nls \
        --without-selinux \
        CFLAGS=-D_QNX_SOURCE \
        LDFLAGS="-lm -lregex -lsocket -lgcc_s"

    make
}

package() {
    make DESTDIR="$pkgdir/" install
}

