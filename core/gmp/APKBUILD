# Maintainer: Leo Shen <yishen@blackberry.com>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=gmp
pkgver=6.3.0
pkgrel=5
pkgdesc="free library for arbitrary precision arithmetic"
url="https://gmplib.org/"
arch="all"
license="LGPL-3.0-or-later OR GPL-2.0-or-later"
makedepends="m4 texinfo libtool autoconf automake clang libc++-dev"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc libgmpxx"
source="https://gmplib.org/download/gmp/gmp-$pkgver.tar.xz"
options="!check"

prepare() {
    default_prepare
    # force update to libtool with fixed cross-build support
    autoreconf -vif
}

build() {
    CFLAGS="$CFLAGS $_lto_cflags" \
    CXX="clang++" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --with-sysroot=$CBUILDROOT \
        --prefix=/usr \
        --infodir=/usr/share/info \
        --mandir=/usr/share/man \
        --localstatedir=/var/state/gmp \
        --enable-cxx \
        --with-pic
        
    make
}

check() {
    [ "$CBUILD" = "$CHOST" ] && make check
}

package() {
    make DESTDIR="$pkgdir" install
}

libgmpxx() {
	pkgdesc="C++ support for gmp"
	depends="$pkgname=$pkgver-r$pkgrel libc++"
	mkdir -p "$subpkgdir"/usr/lib/
	mv "$pkgdir"/usr/lib/libgmpxx.so.* "$subpkgdir"/usr/lib/
}


sha512sums="
