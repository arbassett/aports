9a77b8c3f308ffae2f92ca959e88f8cce24dc550f6a5a89206fbf77f6c1b2ace637abd130220dbf35798f0c6e66b1a6f2ff2bfc3456a79f16b7a146de9f4730b  fix-qnx.patch
"
