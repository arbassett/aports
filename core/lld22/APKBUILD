# Alpine-Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Alpine-Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Alpine-Maintainer: Achill Gilgenast <achill@achill.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
_patch_rev=2
pkgver=22.1.8_p$_patch_rev
pkgrel=0
# NOTE: Upgrade together with the whole LLVM suite.
_llvmver=${pkgver%%.*}
_llvmver_minor=${pkgver#*.}
_llvmver_minor=${_llvmver_minor%%.*}
pkgname=lld$_llvmver
pkgdesc="The LLVM Linker"
url="https://llvm.org/"
arch="all"
license="Apache-2.0"
depends="$pkgname-libs"
depends_libs="llvm22-libs zlib-ng zstd-libs"
depends_dev="$pkgname=$pkgver-r$pkgrel"
#libedit llvm$_llvmver-test-utils
makedepends="
	clang$_llvmver
	cmake
	compiler-rt
	libxml2-dev
	llvm$llvmver
	llvm$_llvmver-dev
	llvm$_llvmver-gtest
	llvm$_llvmver-static
	libunwind-dev
	zlib-dev
	"
checkdepends="gtest-dev bash"
subpackages="$pkgname-dbg $pkgname-libs $pkgname-dev $pkgname-doc"
source="
    https://github.com/qnx-ports/llvm-project/archive/refs/tags/qnx-${pkgver}.tar.gz
    accept-zlib-ng-compessed-size.patch"
_basedir="$srcdir/llvm-project-qnx-$pkgver"
builddir="$_basedir/lld"
_prefix="usr/lib/llvm$_llvmver"

build() {
	CFLAGS="$CFLAGS -O2 -DNDEBUG -g1" \
	CXXFLAGS="$CXXFLAGS -O2 -DNDEBUG -g1" \
	CC=clang-$_llvmver CXX=clang++-$_llvmver \
	cmake -B build -G Ninja -Wno-dev \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/"$_prefix" \
		-DCMAKE_SKIP_INSTALL_RPATH=ON \
		-DBUILD_SHARED_LIBS=ON \
		-DLLVM_INCLUDE_TESTS="$(want_check && echo ON || echo OFF)" \
		-DLLVM_EXTERNAL_LIT="/usr/lib/llvm$_llvmver/bin/lit" \
		-DLLD_BUILT_STANDALONE=ON \
		-DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS -Wl,-z,stack-size=2097152"
	cmake --build build
}

check() {
	ninja -C build check-lld
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 docs/ld.lld.1 -t "$pkgdir/usr/share/man/man1/ld.lld-$_llvmver.1"

	mkdir -p  "$pkgdir"/usr/bin

	for _binname in lld ld.lld ld64.lld lld-link wasm-ld; do
	    ln -s "/../lib/llvm$_llvmver/bin/$_binname" "$pkgdir/usr/bin/$_binname-$_llvmver"
	done


}

libs() {
	mkdir -p "$subpkgdir"
	cd "$subpkgdir"

	mkdir -p "$subpkgdir"/usr/lib
	mkdir -p "$subpkgdir/$_prefix"/lib

	for _libname in COFF Common ELF MachO MinGW Wasm; do
            _lib="liblld$_libname.so.$_llvmver.$_llvmver_minor"
            mv "$pkgdir/$_prefix/lib/$_lib" usr/lib
            ln -s ../../"$_lib" "$_prefix/lib/$_lib"
        done
}

dev() {
	default_dev

	amove "$_prefix/lib/cmake/lld"
	amove "$_prefix/lib/liblld*"

	mkdir -p "$subpkgdir"/usr/lib/cmake
	ln -sfv ../llvm$_llvmver/lib/cmake/lld "$subpkgdir"/usr/lib/cmake/lld$_llvmver

}


sha512sums="
2a458bec38ddb3306a6ad0732784b71f508c919812a28fb37668575000d0c42bb578da4b3c4b62de3e4cedf67a71c670cc781670d3a9ce68b913a8091de147b6  qnx-22.1.8_p2.tar.gz
cf1aaa583f3f3558b6362730c6725e6760c27665b1f9c439328b28f7c0fcc1002c4fd57f503d279419ad297da4cfde46039a0ace6dcf09c37fd6c650896c03b9  accept-zlib-ng-compessed-size.patch
"
