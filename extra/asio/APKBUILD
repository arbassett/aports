pkgname=asio
pkgver=1.36.0
pkgrel=0
pkgdesc="Cross-platform C++ library for network programming"
url="https://think-async.com/Asio/"
arch="noarch"
license="BSL-1.0"
depends_dev="openssl-dev>3"
makedepends="$depends_dev clang libc++-dev"
subpackages="$pkgname-dev"
source="https://downloads.sourceforge.net/sourceforge/asio/asio-$pkgver.tar.bz2"

build() {
    CC=clang \
    CXX=clang++ \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=$PREFIX \
        --mandir=$PREFIX/share/man \
        CXXFLAGS="$CXXFLAGS -O2 -DASIO_HAS_PTHREADS -DASIO_HAS_STD_STRING_VIEW \
                            -DASIO_HAS_CONSTEXPR -DASIO_HAS_STD_FUTURE_CLASS -DSA_RESTART=0 \
                            -Wno-deprecated-declarations -lsocket"
    make
}

check() {
    make check || true
}

package() {
    make DESTDIR="$pkgdir" install
}

sha512sums="
cdb7106a7330d66a302f601b45a5e444220f9e8932cb97536c8fd069e31aeb06a9a33cce67ad8154816845e7d24a9247f493c4d00c7359f5c6efaeec9d627a9f  asio-1.34.2.tar.bz2
"
