# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=swig
pkgver=4.3.1
pkgrel=1
pkgdesc="A compiler that makes it easy to integrate C and C++ code with scripting languages"
url="https://www.swig.org/"
arch="all"
license="GPL-3.0-only"
depends="zlib-ng pcre2 libc++"
makedepends="zlib-ng-dev pcre2-dev bison clang libc++-dev"
checkdepends="boost-dev perl-dev python3-dev"
subpackages="$pkgname-doc"
source="https://downloads.sourceforge.net/swig/swig-$pkgver.tar.gz
	fix-test-sed-PATH.patch
	"
#TODO: enable when we package boost
options="!check"
build() {
	CC=clang \
    CXX=clang++ \
    CFLAGS="$CFLAGS -Qunused-arguments" \
    CXXFLAGS="$CXXFLAGS -Qunused-arguments" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--with-python3=/usr/bin/python3
	make
}

check() {
	(
	# ccache test seems broken with ccache in the path..
	export PATH="/usr/bin:/bin:/usr/sbin:/sbin"
	make -C CCache check
	)
}

package() {
	make DESTDIR="$pkgdir" install
	install -D -m644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -D -m644 LICENSE-UNIVERSITIES "$pkgdir"/usr/share/licenses/$pkgname/LICENSE-UNIVERSITIES
}


sha512sums="
