# Alpine-Maintainer: Rasmus Thomsen <oss@cogitri.dev>
# Yongxin Dai: <yodai@qnx.com>
pkgname=libhandy
pkgver=1.8.3
pkgrel=0
pkgdesc="Library full of GTK+ widgets for mobile phones"
url="https://gitlab.gnome.org/GNOME/libhandy"
arch="all"
license="LGPL-2.0-or-later"
depends_dev="glib-dev gtk3-dev"
depends="glib gtk3"
makedepends="
    glib-dev
    gobject-introspection-dev
    gtk3-dev
    python3-setuptools
    meson
    vala
    "
options="!check"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-lang"
source="https://download.gnome.org/sources/libhandy/${pkgver%.*}/libhandy-$pkgver.tar.xz"
builddir="$srcdir/libhandy-$pkgver"

build() {
    abuild-meson \
        -Db_lto=false \
        -Dexamples=false \
        -Dtests=false \
        . output
    meson compile ${JOBS:+-j ${JOBS}} -C output
}

check() {
    meson test --print-errorlogs -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
1e0ae363d2a4993c9667243715256b27cb0ecb898fa8f4ea1a914fbeb36c0a9c26447f8f13f92f5a855e45ada49f732adeb30b88d81f3ee5f984bca48db3ae65  libhandy-1.8.3.tar.xz
"
