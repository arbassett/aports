2f8b54e8ee7e8fe0d73eb7f5b134ae0b956454ad0b5a528d87f3431a94fcbaf3fc0b0bdd72e435149a9da5b53857a3ef0e2a92838724876adc85bc2ccb5e66eb  qnx-compat.patch
"
