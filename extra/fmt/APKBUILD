# Alpine=Contributor: Luca Weiss <luca@lucaweiss.eu>
# Alpine-Contributor: Duncan Bellamy <dunk@denkimushi.com>
# Alpine-Maintainer Achill Gilgenast <achill@achill.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=fmt
pkgver=12.1.0
pkgrel=0
pkgdesc="Open-source formatting library for C++"
url="https://fmt.dev/latest/index.html"
arch="all"
license="MIT"
depends="libc++"
makedepends="cmake python3 ninja gtest clang libc++-dev"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/fmtlib/fmt/archive/refs/tags/$pkgver.tar.gz"

build() {
    if [ "$CBUILD" != "$CHOST" ]; then
        _cmake_crossopts="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
    fi
    CC="clang"
    CXX="clang++"
    # Build in-tree so the prebuilt docs get installed correctly.
    # See https://github.com/fmtlib/fmt/issues/2837
    cmake -B . -G Ninja \
        -DCMAKE_SKIP_RPATH=ON \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=True \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_EXE_LINKER_FLAGS="-lregex -Wl,--stack=8388608" \
        $_cmake_crossopts
    cmake --build .
}

check() {
    # libstdc++ locale stuff broken
    ctest -E 'chrono-test|unicode-test|xchar-test' || msg "Locale issue and float formatting"
}

package() {
    DESTDIR="$pkgdir" cmake --install .
}


sha512sums="
