# Alpine-Contributor: Valery Kartel <valery.kartel@gmail.com>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=aspell
pkgver=0.60.8.1
pkgrel=0
pkgdesc="A spell checker designed to eventually replace Ispell"
url="http://aspell.net/"
arch="all"
license="LGPL-2.1-or-later"
subpackages="$pkgname-compat::noarch $pkgname-utils $pkgname-dev $pkgname-doc
    $pkgname-lang $pkgname-libs"
depends_dev="$pkgname-utils"
depends="$pkgname-libs=$pkgver-r$pkgrel libc++"
makedepends="ncurses-dev perl gettext-dev libc++-dev clang"
source="https://mirror.csclub.uwaterloo.ca/gnu/aspell/aspell-$pkgver.tar.gz
        fix-clang-21.patch
    "

prepare() {
    default_prepare
    update_config_sub
}

build() {
    CC=clang \
    CXX=clang++ \
    CFLAGS="$CFLAGS -Qunused-arguments" \
    CXXFLAGS="$CXXFLAGS -Qunused-arguments" \
    CPPFLAGS="$CPPFLAGS -Qunused-arguments" \
    LDFLAGS="$LDFLAGS -lintl" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --enable-dict-dir=/usr/share/$pkgname \
        --enable-pkgdatadir=/usr/share/$pkgname \
        --enable-compile-in-filters
    make
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install
}

compat() {
    pkgdesc="aspell compatibility scripts for ispell and unix spell"
    depends="$pkgname"
    install -d "$subpkgdir"/usr/bin
    cd "$pkgdir"/usr/share/$pkgname
    mv spell ispell "$subpkgdir"/usr/bin/
}

utils() {
    pkgdesc="aspell misc utils"
    depends="$pkgname perl"
    install -d "$subpkgdir"/usr/bin
    cd "$pkgdir"/usr/bin
    mv pre* aspell-import run-with-aspell word-list-compress "$subpkgdir"/usr/bin/
}

libs() {
    depends="ncurses libintl"
    default_libs
    mv "$pkgdir"/usr/share "$subpkgdir"/usr
    rm -fr "$pkgdir"/usr/lib
}

sha512sums="
