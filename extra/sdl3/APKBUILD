# Alpine-Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=sdl3
_pkgname=SDL
pkgver=3.2.28
pkgrel=0
pkgdesc="Simple Directmedia Layer"
url="https://libsdl.org/"
arch="all"
license="Zlib"
depends="
     qnx-alsa
     qnx-screen
     qnx-egl
     qnx-gles
     wayland
     libxkbcommon"
makedepends="
     qnx-alsa-dev
     qnx-screen-dev
     egl-headers
     gles-headers
     wayland-dev
     wayland-protocols
     qnx-usb-static
     qnx-usb-dev
     libxkbcommon-static
     libxkbcommon-dev
     autoconf
     clang
     ninja"
subpackages="$pkgname-static $pkgname-dev $pkgname-dbg $pkgname-doc"
_git_rev=4
source="$pkgname-$pkgver-r$_git_rev.tar.gz::https://www.github.com/qnx-ports/$_pkgname/archive/refs/tags/qnx-release-$pkgver-r$_git_rev.tar.gz"
builddir="$srcdir/$_pkgname-qnx-release-$pkgver-r$_git_rev"

options="!check"

build() {
    export CPPFLAGS="${CPPFLAGS} -D_QNX_SOURCE -Wno-error=incompatible-function-pointer-types"
    cmake -B build-shared -G Ninja \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_ASM_COMPILER=clang \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=True \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DQNX=800 \
        -DSDL_X11=0 \
        -DSDL_WAYLAND=1 \
        -DSDL_VIDEO=1 \
        -DSDL_AUDIO=1 \
        -DSDL_JOYSTICK=1
    cmake --build build-shared

    cmake -B build-static -G Ninja \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_ASM_COMPILER=clang \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=False \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DQNX=800 \
        -DSDL_X11=0 \
        -DSDL_WAYLAND=1 \
        -DSDL_VIDEO=1 \
        -DSDL_AUDIO=1 \
        -DSDL_JOYSTICK=1
    cmake --build build-static
}

package() {
    DESTDIR="$pkgdir" cmake --install build-static
    DESTDIR="$pkgdir" cmake --install build-shared
}

sha512sums="
5a87906d6ec8070b17b7ea2b99d10bd1e68552de043d9b4027f2de3b6e800b55303c6a91d0d9512b769e456d2a8cc72e0af6e44464e7e79d115c8131e6e2579a  sdl3-3.2.28-r4.tar.gz
"
