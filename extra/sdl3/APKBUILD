# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=sdl3
_pkgname=SDL
pkgver=3.2.28
pkgrel=0
pkgdesc="Simple Directmedia Layer"
url="https://libsdl.org/"
arch="all"
license="Zlib"
depends="qnx-alsa
    qnx-screen
    qnx-egl
    qnx-gles
    wayland
    libxkbcommon"
makedepends="qnx-alsa-dev
     qnx-screen-dev
     egl-headers
     gles-headers
     wayland-dev
     qnx-usb-static
     qnx-usb-dev
     libxkbcommon-static
     libxkbcommon-dev
     autoconf
     clang
     ninja"
subpackages="$pkgname-static $pkgname-dev"
_git_rev=1
source="$pkgname-$pkgver-r$_git_rev.tar.gz::https://www.github.com/qnx-ports/$_pkgname/archive/refs/tags/qnx-release-$pkgver-r$_git_rev.tar.gz"
builddir="$srcdir/$_pkgname-qnx-release-$pkgver-r$_git_rev"

options="!check"

build() {
    extra_cmake_args=""
    if [[ $CBUILD = $CHOST ]]; then
	# Compile natively
	extra_cmake_args=""
    else
	# Cross compiling
	extra_cmake_args="-DCMAKE_TOOLCHAIN_FILE=${CBUILDROOT}/${PREFIX}/share/qnx/qnx_toolchain.cmake"
    fi

    export CPPFLAGS="${CPPFLAGS} -D_QNX_SOURCE -Wno-error=incompatible-function-pointer-types"
    cmake -B build-shared -G Ninja \
	-DCMAKE_C_COMPILER=clang \
	-DCMAKE_CXX_COMPILER=clang++ \
	-DCMAKE_ASM_COMPILER=clang \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DBUILD_SHARED_LIBS=True \
	-DCMAKE_SKIP_INSTALL_RPATH=ON \
	-DQNX=800 \
	-DSDL_X11=0 \
	-DSDL_WAYLAND=1 \
	-DSDL_VIDEO=1 \
	-DSDL_AUDIO=1 \
	-DSDL_JOYSTICK=1 \
	$extra_cmake_args
    cmake --build build-shared

    cmake -B build-static -G Ninja \
	-DCMAKE_C_COMPILER=clang \
	-DCMAKE_CXX_COMPILER=clang++ \
	-DCMAKE_ASM_COMPILER=clang \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DBUILD_SHARED_LIBS=False \
	-DCMAKE_SKIP_INSTALL_RPATH=ON \
	-DQNX=800 \
	-DSDL_X11=0 \
	-DSDL_WAYLAND=1 \
	-DSDL_VIDEO=1 \
	-DSDL_AUDIO=1 \
	-DSDL_JOYSTICK=1 \
	$extra_cmake_args
    cmake --build build-static
}

package() {
    DESTDIR="$pkgdir" cmake --install build-static
    DESTDIR="$pkgdir" cmake --install build-shared
}

sha512sums="
