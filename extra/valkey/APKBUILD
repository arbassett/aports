pkgname=valkey
pkgver=8.1.4
pkgrel=0
pkgdesc="Open source high-performance key/value datastore (fork of Redis)"
url="https://valkey.io/"
arch="all"
license="BSD-3-Clause"
pkgusers="valkey"
pkggroups="valkey"
depends="qnx-io-sock libssl3 libcrypto3"
makedepends="openssl-dev qnx-io-sock-dev cmake ninja clang libc++-dev"
install="
    $pkgname.pre-install
    $pkgname.post-install
    "
subpackages="
    $pkgname-benchmark
    $pkgname-cli
    hiredis-dev
    "
source="https://github.com/valkey-io/valkey/archive/$pkgver/valkey-$pkgver.tar.gz
    fix-IOV_MAX.patch
    "

build() {
    # GCC has lots of unnecessary errors.....
    cmake3.5 -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX="/usr" \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DBUILD_MALLOC=libc \
        -DBUILD_UNIT_TESTS=yes \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TLS=yes

    ninja -C build -j4
}

check() {
    # unit test only
    cd "$builddir"/build
    ./bin/valkey-unit-tests
}

package() {
    sed 's|${DESTDIR}|${DESTDIR}/usr|' build/CreateSymlink.sh > build/CreateSymlink.sh
    DESTDIR="$pkgdir" ninja -C build install

    cd "$pkgdir"
    rm -rf build
    
    # QNX bug, the user has been changed
    install -d -m 750 -o valkey -g valkey \
        etc/valkey \
        etc/valkey/valkey.d \
        var/lib/valkey \
        var/lib/valkey/sentinel || true

    install -D -m 640 -o root -g valkey "$builddir"/valkey.conf etc/valkey/valkey.conf || true
    install -D -m 640 -o valkey -g valkey "$builddir"/sentinel.conf etc/valkey/sentinel.conf || true
}

benchmark() {
    depends="qnx-io-sock libssl3 libcrypto3"
    pkgdesc="Valkey benchmarking tool"

    amove usr/bin/valkey-benchmark
}

cli() {
    depends="qnx-io-sock libssl3 libcrypto3"
    pkgdesc="Valkey CLI client"

    amove usr/bin/valkey-cli
}

