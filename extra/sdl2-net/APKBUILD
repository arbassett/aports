# Alpine-Contributor: Alex Raschi <raschi.alex@gmail.com>
# Alpine-Maintainer: Clayton Craft <clayton@craftyguy.net>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=sdl2-net
_pkgname=SDL_net
pkgver=2.2.0
pkgrel=0
pkgdesc="A simple, cross-platform wrapper over TCP/IP sockets."
url="https://libsdl.org/"
arch="all"
license="Zlib"
depends="
    qnx-io-sock
    sdl3
    sdl2-compat
    "
makedepends="
    qnx-io-sock-dev
    sdl3-dev
    sdl3-static
    sdl2-compat-dev
    sdl2-compat-static
    autoconf
    clang
    ninja
    "
subpackages="$pkgname-static $pkgname-dev $pkgname-dbg $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://www.github.com/libsdl-org/$_pkgname/archive/refs/tags/release-$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-release-$pkgver"

options="!check"

build() {
    export CPPFLAGS="${CPPFLAGS} -D_QNX_SOURCE"
    export LDFLAGS="${LDFLAGS} -lsocket"
    cmake -B build-shared -G Ninja \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_ASM_COMPILER=clang \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DQNX=800 \
        -DSDL2NET_INSTALL=ON
    cmake --build build-shared

    cmake -B build-static -G Ninja \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_ASM_COMPILER=clang \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DQNX=800 \
        -DSDL2NET_INSTALL=ON
    cmake --build build-static
}

package() {
    DESTDIR="$pkgdir" cmake --install build-static
    DESTDIR="$pkgdir" cmake --install build-shared
}

sha512sums="
eb9be264857b763291acf72fbbc7e72c612aa3555fb563e8d91d11dec64883f1911bcf3312e78edc9d64b3531e0ab35270a4b75a324411431be13db7e85471f1  sdl2-net-2.2.0.tar.gz
"
