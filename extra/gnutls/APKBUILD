75c39c6e78bb5185b4f9ed3bb52d17d051a169965d6eb2cfcf28c9a1420d5de6e8c4599bc64002be44f86536c83d0dcc53b23e958ea301a94710e0b9f0b96aec  fix-qnx.patch
"
